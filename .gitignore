# ──────────────────────────────────────────────────────────
# Thoth · .gitignore
# ──────────────────────────────────────────────────────────

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Databases (generated at runtime)
store.db
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Environment & secrets
.env
.env.*
*.env
!.env.example
.env.local
.env.*.local
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Node / Web (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# DeepEval / Confident AI local state
.deepeval/
.deepeval_cache/

# Stray root-level dump files (auto-generated during dev sessions)
thoth_chat_summary_with_thinking.md
thoth_full_chat_history_with_thinking.md
thoth_modification_plan.md
diagnostic_test.py

# Research Vault contents — keep directory skeleton, ignore generated notes
vault/topics/*.md
vault/sources/*.md

# User local study materials & external reference repos
handling api limit like feynman/
handling api limit like feynman
research_repos/
research_repos

# AI assistant & IDE metadata
.gemini/
.agents/

# Streamlit local runtime settings
.streamlit/

# General logs
*.log
