# ---------- Local data ----------
# SQLite stores (db/store.db and test DBs). Postgres schema lives in db/migrations/.
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
# Generated vault notes (per-user research output).
vault/topics/*.md
vault/sources/*.md
supabase/.temp/
# Results from the archived pipeline evaluations.
docs/archive/legacy_code/pipeline_v1/backend/evals/production_eval_results.json

# ---------- Logs ----------
*.log
# Raw tool output kept as verification evidence.
!docs/archive/verify/_logs/*.log

# ---------- Runtime artefacts ----------
# backend/main.py creates backend/backend -> backend at startup (Railway deploys rooted at /backend).
backend/backend

