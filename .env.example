# ==============================================================================
# THOTH MONOREPO ENVIRONMENT TEMPLATE
# Copy to .env and supply your credentials. NEVER commit actual keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & NETWORKING
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. FRONTEND / WEB SERVICE (Railway Service 1)
# ------------------------------------------------------------------------------
# URL of the backend API gateway. Empty string for same-origin relative calls.
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. SUPABASE (Identity, PostgreSQL, RLS, Vectors)
# ------------------------------------------------------------------------------
# Required for both Frontend and Backend
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key_here

# Backend Only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ------------------------------------------------------------------------------
# 4. REDIS (Railway Add-on: Caching & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400

# ------------------------------------------------------------------------------
# 5. LLM INFERENCE PROVIDERS (Primary, Fallback, Verification)
# ------------------------------------------------------------------------------
# Primary Research Model (NVIDIA NIM)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Secondary High-Speed Fallback (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b

# Tertiary Model Fallback (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. SCHOLARLY SEARCH & EMBEDDINGS
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 7. EVALUATION & OBSERVABILITY
# ------------------------------------------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=YES
