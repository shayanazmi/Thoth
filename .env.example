# ==============================================================================
# Thoth Environment Configuration Template
# Copy this file to .env and fill in your respective API keys.
# DO NOT commit the .env file with actual credentials to version control.
# ==============================================================================

# [Required] Tavily Search API Key for real-time web exploration & fact-checking
# Sign up at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# [Primary Provider] NVIDIA AI Foundation Endpoints API Key
# Powers Nemotron-30B (Synthesis/Judge) and Llama-3.1-8B (Truth Guard) NIMs
# Sign up at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# [Optional Fallback] OpenAI API Key
# Used as secondary fallback provider in LLMDispatcher
# Sign up at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# [Optional Fallback] Groq Cloud API Key
# Used for ultra-low latency open-weights inference fallback
# Sign up at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
