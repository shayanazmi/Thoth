# Thoth configuration. Copy to .env and fill in what you have. Never commit .env.
# Thoth · Developed by Shayan Azmi

# --- Server ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Models ---
# Required for real runs: a free NVIDIA NIM key (https://build.nvidia.com).
NVIDIA_API_KEY=
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Groq: four of the thinkers speak through Groq models (backend/agents.py THINKER_ASSIGNMENT), and it is the
# last fallback for every other role. Without it those thinkers use the shared NIM thinker model.
# OpenAI is used only when there is no Groq key.
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=

# --- Literature databases (all optional; anonymous access works, keys raise the limits) ---
# OpenAlex: a free key (https://openalex.org/settings/api) enables cursor paging and gives you your own daily budget.
OPENALEX_API_KEY=
# Semantic Scholar: falls back to the shared anonymous pool when the key is rate limited.
SEMANTIC_SCHOLAR_API_KEY=

# --- Storage ---
# SQLite file; the default is database/thoth.db.
# THOTH_DB_PATH=database/thoth.db

# --- Tests ---
# THOTH_LIVE_TESTS=1   runs the one live-model test (uses your keys)
